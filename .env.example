# Server-side only. Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Local stdio transport. Leave blank when using hosted Streamable HTTP.
GRAFANA_URL=http://localhost:3000
GRAFANA_PUBLIC_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
GRAFANA_ORG_ID=
GRAFANA_MCP_COMMAND=uvx
GRAFANA_MCP_ARGS=mcp-grafana
# Hosted Streamable HTTP transport, required for Vercel production publishing.
GRAFANA_MCP_URL=
GRAFANA_MCP_SERVER_TOKEN=
GRAFANA_MCP_TIMEOUT_SECONDS=20
GRAFANA_MCP_TOOL_FILTER=create_annotation,create_dashboard,get_dashboard_by_uid,list_datasources,query_loki_logs,query_prometheus,search_dashboards,update_dashboard
SHOOT_LAT=
SHOOT_LON=
UCS_WRITE_STATIC_OUTPUT=0
